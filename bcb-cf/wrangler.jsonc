// wrangler.jsonc — BCB landing on Cloudflare Workers
{
  "name": "bcb-landing",
  "main": "src/worker.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],

  // Serve the Vite build output. The Worker handles /api/* and falls through
  // to static assets for everything else.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // D1 database for tester leads.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bcb-leads",
      "database_id": "da0611d7-2e7c-4bad-b3d1-39aa7d6a6d0d",
      "migrations_dir": "migrations"
    }
  ],

  // Outbound email for owner lead notifications. `destination_address` must be a
  // verified destination in Cloudflare Email Routing, and the sender domain
  // (leads@bcb-lab.com) must have Email Routing enabled.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "jahyag@gmail.com"
    }
  ],

  // Keep the *.workers.dev URL enabled alongside custom domains.
  "workers_dev": true,

  // Public custom domains served by this Worker (DNS + cert auto-managed).
  // NOTE: the apex `bcb-lab.com` is attached out-of-band (its pre-existing DNS
  // record must be replaced first); only `www` is managed here for now.
  "routes": [
    { "pattern": "www.bcb-lab.com", "custom_domain": true }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
